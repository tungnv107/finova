# Bound Prisma pool per application replica. Re-evaluate with real staging load/DB max_connections.
# Windows + Docker Desktop: use IPv4 explicitly. localhost may resolve to ::1 and delay Prisma pool startup ~2 s.
DATABASE_URL="postgresql://finova:local_dev_change_me@127.0.0.1:55433/finova?schema=public&connection_limit=16"
FINOVA_DB_PORT="55433"
# Internal Docker-network URL for `docker compose --profile app` (match DB password).
FINOVA_CONTAINER_DATABASE_URL="postgresql://finova:local_dev_change_me@db:5432/finova?schema=public&connection_limit=16"
# Supply explicitly before `docker compose --profile release run --rm migrate`.
# FINOVA_MIGRATION_DATABASE_URL="postgresql://finova:<url-encoded-password>@db:5432/finova?schema=public"
FINOVA_APP_PORT="3002"
# Set only for compose.npm.yaml; choose an existing user-defined Docker network
# already attached to the Nginx Proxy Manager container on the server.
# FINOVA_NPM_NETWORK="npm_default"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3002"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3002"
# Enable CSP enforcement only after reviewing Report-Only violations in real browsers.
FINOVA_CSP_ENFORCE="0"
# Optional: enable per-IP OAuth quota ONLY behind an ingress which overwrites
# the specified header and blocks direct traffic to the Next.js app.
# Supported: cf-connecting-ip, x-real-ip, true-client-ip. Never X-Forwarded-For.
# FINOVA_TRUSTED_CLIENT_IP_HEADER="cf-connecting-ip"
# Internal scheduler (24+ random characters); required only when scheduler is enabled.
FINOVA_CRON_SECRET=""
FINOVA_BANK_REPLAY_SECRET=""

# Bank statement staging: use a separately managed random 32-byte AES key.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never rotate this value without re-encrypting existing bank_raw_events and testing restore.
FINOVA_BANK_EVENT_KEY=""
# Synthetic HMAC webhook for development only; disabled even with flag in production.
FINOVA_BANK_SANDBOX_ENABLED="0"
FINOVA_BANK_SANDBOX_SECRET=""
FINOVA_SEPAY_BANKHUB_ENABLED="0"
# Choose sandbox until merchant verification, staging UAT, and release approval.
FINOVA_SEPAY_BANKHUB_ENV="sandbox"
FINOVA_SEPAY_BANKHUB_CLIENT_ID=""
FINOVA_SEPAY_BANKHUB_CLIENT_SECRET=""
# Merchant IPN Authorization header: Apikey <value>. Keep this server-only.
FINOVA_SEPAY_BANKHUB_IPN_API_KEY=""

# System Admin / paid subscriptions. All flags remain OFF until security, finance,
# provider UAT, privacy and production release approvals.
FINOVA_ADMIN_ENABLED="0"
# Enable after UserAccessState migration; keep enabled when rolling back Admin UI.
FINOVA_USER_ACCESS_ENFORCED="0"
FINOVA_PREMIUM_ENTITLEMENTS_ENFORCED="0"
FINOVA_BILLING_CHECKOUT_ENABLED="0"
# 64 hexadecimal characters (32 random bytes), server only.
FINOVA_BILLING_ENCRYPTION_KEY=""
# SePay merchant receiving account webhook, independent of users' Bank Hub.
FINOVA_BILLING_SEPAY_WEBHOOK_ENABLED="0"
FINOVA_BILLING_SEPAY_WEBHOOK_SECRET=""
FINOVA_BILLING_SEPAY_RECEIVER_ID=""

# Scheduler calls POST /api/internal/billing/operations with FINOVA_CRON_SECRET every 5 minutes.
# Keep OFF until an independently monitored scheduler and operators are configured.
FINOVA_BILLING_ALERTS_ENABLED="0"
# Optional provider-operated HTTPS health endpoint; no IPN outage inference from silence.
FINOVA_BILLING_PROVIDER_HEALTH_URL=""
# Optional independent alert relay. It verifies signed payloads, deduplicates eventId,
# maps FINANCE_OPERATOR/ADMIN/SUPER_ADMIN audiences to on-call destinations.
FINOVA_BILLING_ALERT_RELAY_URL=""
FINOVA_BILLING_ALERT_RELAY_SECRET=""

# Authenticated product pageview aggregates (no IP, raw URL or finance ledger data).
# Requires privacy/consent review before enabling in production.
FINOVA_USAGE_ANALYTICS_ENABLED="0"

# AI P0: server-side only. Never use NEXT_PUBLIC_ for credentials.
# Apply database migrations before enabling statement review.
OPENAI_API_KEY=""
FINOVA_AI_MODEL="gpt-4.1"

# Optional OpenAI-compatible provider. Set all three to override OpenAI.
# Example endpoint: https://9router.haui.com.vn/v1 ; model: tungnv
LLM__Endpoint=""
LLM__ApiKey=""
LLM__ChatModelId=""
# Optional: chat-completions (default) or responses. Leave blank for OpenAI.
LLM__ApiMode=""
# Optional: json_object (custom default) or json_schema (strict, if supported).
LLM__ResponseFormat=""
