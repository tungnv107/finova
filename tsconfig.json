{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@finova/prisma": [
        "./generated/prisma-client"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-admin-qa/types/**/*.ts",
    ".next-admin-qa/dev/types/**/*.ts",
    ".next-admin-ui2-qa/types/**/*.ts",
    ".next-admin-ui2-qa/dev/types/**/*.ts",
    ".next-admin-ops-qa/types/**/*.ts",
    ".next-admin-ops-qa/dev/types/**/*.ts",
    ".next-ad207-verify/types/**/*.ts",
    ".next-ad207-verify/dev/types/**/*.ts",
    ".next-build-qa-25i-elev/types/**/*.ts",
    ".next-build-qa-25i-elev/dev/types/**/*.ts",
    ".next-qa-analytics-25i/types/**/*.ts",
    ".next-qa-analytics-25i/dev/types/**/*.ts",
    ".next-ad206-qa-20261026/types/**/*.ts",
    ".next-ad206-qa-20261026/dev/types/**/*.ts",
    ".next-build-qa-ad206-elevated/types/**/*.ts",
    ".next-build-qa-ad206-elevated/dev/types/**/*.ts",
    ".next-ai-p0-qa/types/**/*.ts",
    ".next-ai-p0-qa/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*",
    ".next/dev"
  ]
}
