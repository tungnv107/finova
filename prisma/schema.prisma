  retryCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  @@unique([eventType, aggregateId])
  @@index([status, nextAttemptAt])
  @@map("bank_sync_outbox")
}

model BankSyncJob {
  id String @id @default(cuid())
  workspaceId String
  connectionId String
  type String
  status String @default("PENDING")
  fromAt DateTime?
  toAt DateTime?
  cursor String?
  metricsJson Json?
  failureReason String?
  startedAt DateTime?
  leaseUntil DateTime?
  endedAt DateTime?
  connection BankConnection @relation(fields: [workspaceId, connectionId], references: [workspaceId, id], onDelete: Restrict)
