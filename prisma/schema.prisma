model BankReconciliationSnapshot {
  id String @id @default(cuid())
  workspaceId String
  bankAccountId String
  asOfAt DateTime
  balanceType String
  bankBalance Decimal @db.Decimal(20, 4)
  ledgerBalance Decimal @db.Decimal(20, 4)
